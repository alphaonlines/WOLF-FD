# Copy this file to .env for a fresh host. Do not commit secrets.

# Frontend build-time API base URL
VITE_POS_API_BASE_URL=/fd/api

# Core backend + DB
PGHOST=postgres
PGPORT=5432
PGHOST_PORT=5433
PGDATABASE=salesdb
PGUSER=salesapp
PGPASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
PORT=5057
NODE_ENV=production

# Optional host env bootstrap (for legacy non-compose runs)
# WOLF_FD_DOTENV_FILE=/path/to/WOLF-CENTRAL.env

# Auth bootstrap
AUTH_BOOTSTRAP_EMAIL=owner@example.com
AUTH_BOOTSTRAP_NAME=Owner Name
AUTH_BOOTSTRAP_PASSWORD=REPLACE_WITH_SECURE_BOOTSTRAP_PASSWORD
AUTH_SESSION_DAYS=14
AUTH_COOKIE_SECURE=auto

# Google Workspace
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_DOMAIN=furnituredistributors.net

# Social/publication integration
SOCIAL_PUBLIC_BASE_URL=https://furnituredistributors.wolf.discount/fd/api
SOCIAL_SCHEDULER_ENABLED=true
SOCIAL_SCHEDULER_INTERVAL_MS=60000

# Den Recorder / Meetily-backed transcription
DEN_RECORDINGS_DIR=/srv/wolf-den-recordings
MEETILY_WHISPER_BASE_URL=http://127.0.0.1:8178
DEN_RECORDING_TRANSCRIPTION_ENABLED=true
DEN_RECORDING_SUMMARY_ENABLED=true

# BotBot / AI / LLM
BOTBOT_ENABLED=true
BOTBOT_LOCAL_AI_URL=http://192.168.4.80:3000
BOTBOT_LOCAL_AI_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_BALANCED_MODEL=gpt-4o
ANTHROPIC_API_KEY=
OLLAMA_NODE_MSI_URL=http://192.168.4.80:11434
OLLAMA_NODE_ALPHABS_URL=http://192.168.4.187:11434
OLLAMA_NODE_ALPHABS1_URL=http://192.168.4.174:11434
OLLAMA_NODE_ALPHAHS_URL=http://127.0.0.1:11434
OLLAMA_PRIMARY_MODEL=gemma4:e4b-it-q4_K_M

# Weather cache and CRM tuning (optional)
CRM_WEATHER_TIMEOUT_MS=3500
CRM_WEATHER_CACHE_TTL_MS=900000
CRM_WEATHER_USER_AGENT=WOLF-FD CRM Weather (ops@wolf.discount)
CRM_WEATHER_STORE_COORDS_JSON=

# Optional board AI / scheduling
BOARD_AI_AGENT_ENABLED=false
BOARD_AI_AGENT_INCLUDE_WEEKENDS=false
