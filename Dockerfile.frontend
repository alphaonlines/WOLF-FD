FROM node:18-alpine AS builder

WORKDIR /app

ARG VITE_POS_API_BASE_URL=/fd/api

COPY package*.json ./
RUN npm ci

COPY . .
RUN printf 'VITE_POS_API_BASE_URL=%s\n' "$VITE_POS_API_BASE_URL" > .env.production
RUN npm run build

FROM nginx:alpine AS runner

WORKDIR /usr/share/nginx/html

COPY --from=builder /app/dist ./

COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]